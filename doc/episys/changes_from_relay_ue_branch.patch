+    sed -i 's/24.04/22.04/g' /etc/os-release && \
+    # Remove existing files that the script will try to symlink over
+    rm -f /usr/include/sys/*.h
+
+# 4. PATCH BUILD HELPERS FOR NOBLE COMPATIBILITY
+WORKDIR /openair-upf/build/common-build/installation
+# Fix CPR: disable -Werror for deprecated curl APIs on Noble's curl 8.5
+RUN sed -i 's|cmake .. -DCPR_USE_SYSTEM_CURL=ON -DCPR_BUILD_TESTS=OFF|cmake .. -DCPR_USE_SYSTEM_CURL=ON -DCPR_BUILD_TESTS=OFF -DCMAKE_CXX_FLAGS="-Wno-error=deprecated-declarations"|' \
+    build_helper.cpr
+# Fix Folly: add missing #include <system_error> for GCC 13+
+RUN sed -i '/s@folly::constexpr_max@@/a\    sed -i "1i #include <system_error>" folly/detail/AtFork.cpp' \
+    build_helper.fb_folly
+
+# 5. RUN INSTALLER
+WORKDIR /openair-upf/build/scripts
+RUN ./build_upf --install-deps --force
+
+#---------------------------------------------------------------------
+# BUILDER IMAGE
+#---------------------------------------------------------------------
+FROM oai-upf-base AS oai-upf-builder
+
+# Inheritance of environment
+ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/local/lib64/pkgconfig:/usr/lib/pkgconfig
+ENV CMAKE_PREFIX_PATH=/usr/local
+
+COPY . /openair-upf
+WORKDIR /openair-upf/build/scripts
+
+# Re-apply symlink crash prevention to the host-copied files
+RUN rm -f /usr/include/sys/*.h
+
+# Fix GCC 13 missing implicit <cstdint> includes in common-src headers
+RUN sed -i 's|set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS} -std=c++17|set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS} -std=c++17 -include cstdint|' \
+    /openair-upf/src/oai_upf/CMakeLists.txt && \
+    sed -i 's|set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS} -std=c++17|set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS} -std=c++17 -include cstdint|' \
+    /openair-upf/src/oai_upf/CMakeLists.txt && \
+    sed -i 's|set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CMAKE_CXX_FLAGS} -std=c++17|set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CMAKE_CXX_FLAGS} -std=c++17 -include cstdint|' \
+    /openair-upf/src/oai_upf/CMakeLists.txt && \
+    sed -i 's|set(CMAKE_CXX_FLAGS_MINSIZEREL "${CMAKE_CXX_FLAGS} -std=c++17|set(CMAKE_CXX_FLAGS_MINSIZEREL "${CMAKE_CXX_FLAGS} -std=c++17 -include cstdint|' \
+    /openair-upf/src/oai_upf/CMakeLists.txt
+
+RUN if [ "$ENABLE_LTTNG" = "true" ]; then apt-get update && \
+        apt-get install --yes libstdc++-13-dev lttng-modules-dkms liblttng-ust-dev lttng-tools && \
+        ldconfig && \
+        ./build_upf --clean --Verbose --build-type Release --jobs --lttng; \
+    else \
+        ldconfig && \
+        ./build_upf --clean --Verbose --build-type Release --jobs; \
+    fi && \
+    if [ -f /openair-upf/build/upf/build/upf ]; then \
+        mv /openair-upf/build/upf/build/upf /openair-upf/build/upf/build/oai_upf; \
+    fi
+
+#---------------------------------------------------------------------
+# TARGET IMAGE
+#---------------------------------------------------------------------
+FROM $BASE_IMAGE AS oai-upf
+ENV DEBIAN_FRONTEND=noninteractive
+ENV TZ=Europe/Paris
+ARG ENABLE_LTTNG=false
+
+RUN apt-get update && \
+    apt-get upgrade --yes && \
+    apt-get install --yes \
+      tzdata psmisc net-tools iproute2 ethtool arping \
+      libllvm18 libnl-3-200 libnl-route-3-200 sudo iptables netbase \
+      libasan8 libgssapi-krb5-2 libldap-dev libgoogle-glog0v6 \
+      libdouble-conversion3 libconfig++9v5 librtmp1 libpsl5 \
+      libnghttp2-14 libcurl4-gnutls-dev libboost-thread1.83.0 \
+  && if [ "$ENABLE_LTTNG" = "true" ]; then apt-get install --yes liblttng-ust-dev; fi \
+  && rm -rf /var/lib/apt/lists/*
+
+# Iperf3 and ffmpeg
+RUN apt-get update && apt-get install -y build-essential git autoconf automake libtool ffmpeg && rm -rf /var/lib/apt/lists/*
+WORKDIR /app
+RUN git clone https://github.com/esnet/iperf.git && cd iperf && git checkout 3.16 && ./bootstrap.sh && ./configure && make && make install
+
+# Final Assembly
+WORKDIR /openair-upf/bin
+COPY --from=oai-upf-builder \
+    /usr/local/sbin/bpftool \
+    /openair-upf/build/upf/build/oai_upf \
+    /openair-upf/scripts/healthcheck.sh \
+    /openair-upf/scripts/entrypoint.sh \
+    ./
+
+# Wildcard BPF copy
+COPY --from=oai-upf-builder \
+    /openair-upf/build/upf/build/upf_app/bpf/CMakeFiles/qer_tc.dir/*/qer/qer_tc_kernel.c.o \
+    ./qer_tc_kernel.c.o
+
+WORKDIR /usr/local/lib
+COPY --from=oai-upf-builder \
+    /usr/local/lib/libfmt.so* \
+    /usr/local/lib/libyaml-cpp.so* \
+    /usr/local/lib/libcpr.so* \
+    /usr/lib/x86_64-linux-gnu/libbfd-2.42-system.so \
+    /usr/lib/x86_64-linux-gnu/libopcodes-2.42-system.so \
+    /openair-upf/build/ext/libbpf/src/libbpf.so* \
+    ./
+
+RUN ldconfig && ldd /openair-upf/bin/oai_upf
+
+WORKDIR /openair-upf/etc
+COPY --from=oai-upf-builder /openair-upf/etc/config.yaml .
+
+WORKDIR /openair-upf
+EXPOSE 2152/udp 8805/udp 5342 5343 5344
+HEALTHCHECK --interval=10s --timeout=15s --retries=6 CMD /openair-upf/bin/healthcheck.sh
+
+CMD ["/openair-upf/bin/oai_upf", "-c", "/openair-upf/etc/config.yaml", "-o"]
+ENTRYPOINT [ "sh", "/openair-upf/bin/entrypoint.sh" ]
